[General]
; Example: N1ADJ or N1ADJ G
Callsign=CALLSIGN_PLACEHOLDER
DashboardLog=/opt/m17/m17-gateway/dashboard.log
AudioDir=audio/

[Radio]
; Hertz
RXFrequency=439000000
TXFrequency=439000000
; Power dbm
Power=10
AFC=true
FrequencyCorr=0
Duplex=false
; Before sending a packet (SMS), wait until nothing has been received for
; RXHoldoff, so a packet never starts while a radio is still transmitting,
; and at least PacketGap after the gateway's own last packet or voice.
; Defaults 500ms and 250ms.
RXHoldoff=500ms
PacketGap=250ms

[Reflector]
HostFile=/opt/m17/m17-gateway/M17Hosts.txt
OverrideHostFile=/opt/m17/m17-gateway/OverrideHosts.txt
; Leave Name empty to run without a reflector: RF only, nothing sent to or
; received from the network. Local RF works as usual, and a duplex hotspot
; still repeats.
Name=M17-M17
Module=C
; Let local stations change the link over RF, as on M17Gateway: transmit to a
; reflector and module in the host files, such as "M17-M17 C", to link there,
; or to "UNLINK"; the gateway says what it did. Off by default.
RFLinking=false
; Who may do it, separated by commas, with * for any SSID or suffix, such as
; N0CALL*. Empty lets anyone in range.
LinkCallsigns=
; Go back to Name/Module above once nothing has been received on RF for this
; long. 0 stays put until a restart.
RevertAfter=15m
; The link, who changed it, and when it goes back, as JSON for the dashboard.
LinkStatus=/opt/m17/m17-gateway/link-status.json

[APRS]
; Gate APRS packets carried in M17 packet mode (type 0x02, a TNC2 line) between
; RF and APRS-IS, as an iGate does. See docs/aprs-igate.md.
; Changes to this section are applied while the gateway runs, within about
; 10 seconds, except Enabled, which needs a restart to turn on.
Enabled=false
Server=rotate.aprs2.net:14580
; The gate's own APRS callsign, an AX.25 one such as N0CALL-10. Radios take
; packets from APRS-IS with it in their path, so it can't have a letter SSID.
Callsign=
; -1 logs in receive only: nothing is sent to APRS-IS, and what would be is
; logged instead.
Passcode=-1
; Gate packets heard on RF to APRS-IS.
RFtoIS=true
; Added, used, to the path of packets gated from RF, before the q construct,
; to show they came over M17, as D-Star gateways add DSTAR*:
;   K0RET-7>APORT1,M17*,qAR,N0CALL-10:...   Leave empty for none.
PathTag=M17
; Transmit messages from APRS-IS to stations heard on RF in the last
; HeardWindow. Every one is airtime nobody can talk in.
IStoRF=false
; Traffic to watch, beyond messages for stations heard on RF: up to 16 rules,
; Watch1 to Watch16, each
;   call CALL[*]        from that station, or messages to it ('*': any SSID)
;   area LAT LON KM     within KM of a point
;   near KM             within KM of Latitude/Longitude below
; then "rf" to transmit what it brings (except local stations' own), or
; "dashboard" to only log it, and optionally "until" an RFC 3339 time.
; Watch1=call K0RET-4 rf until 2026-10-11T19:00:00Z
; Watch2=near 30 dashboard
; A raw APRS-IS server filter, for anything the rules can't say. What only it
; selects is logged, never transmitted.
Filter=
HeardWindow=60m
; A packet from APRS-IS waits for a quiet channel at most this long; senders
; retry anyway.
MaxQueueAge=60s
; Before each packet from APRS-IS, the channel must have been quiet, both
; received and sent, this long, so that a local station can always key up
; or answer an over first.
MinTxGap=3s
; Packets from APRS-IS per minute, and in a burst.
RateLimit=6
RateBurst=3
; After a message, send its sender's position, once per 30 minutes.
CourtesyPosition=true
; Every APRS line heard on RF or received from APRS-IS, what was done with it,
; and what was sent, as JSON lines for the dashboard's APRS page. Rotated at
; 4 MB. Leave empty for none.
Log=/opt/m17/m17-gateway/aprs.log
; How the gate is doing, as JSON rewritten every 5 seconds for the dashboard:
; the APRS-IS server, login, filter, heard stations, rules, queue, counters.
Status=/opt/m17/m17-gateway/aprs-status.json
; Simplex only: relay APRS messages between two stations both heard on RF,
; which may not hear each other. A message waits RelayHold, and isn't relayed
; if its addressee acks it first; an ack is relayed only for a message that
; was. Positions are never relayed. Duplex gateways repeat everything anyway.
Relay=false
RelayHold=5s
; Send packets whose addresses AX.25 can't hold (WINLINK, KD7ZYN-S) in
; third-party form, for radios that unwrap it, rather than skipping them.
ThirdParty=false
; Beacon the hotspot to APRS-IS, never to RF, as a position with the APRS
; frequency format: PHG (power from [Radio] Power, HAAT in metres, Gain in
; dBi) when HAAT is set, then TXFrequency, the split if RX differs, "M17",
; the CAN, the linked reflector and Comment. For example
;   !3508.37NM09001.05W&PHG0330/441.112MHz M17 CAN0 M17-KCW B M17 hotspot
; Off without a position. Ambiguity 1 to 4 blurs the position, from about
; 0.2 km to 110 km, for a hotspot at home.
; Latitude=35.1234
; Longitude=-90.1234
BeaconInterval=30m
Ambiguity=0
; Gateway symbol with an M overlay; APRS defines no M17 symbol.
Symbol=M&
CAN=0
HAAT=0
Gain=0
Comment=

[Log]
; Logging levels: ERROR, INFO, DEBUG
Level=DEBUG

[Modem]
; Change Type to mmdvm or sx1255 for MMDVM or SX1255 hardware
Type=cc1200
Port=/dev/ttyAMA0
; 460800 for cc1200. Typically 115200 or 460800 for MMDVM.
Speed=460800
; CC1200-specific
NRSTPin=21
Boot0Pin=20
ZMQPort=0
; MMDVM-specific
Protocol=uart
RXInvert=false
TXInvert=true
PTTInvert=false
Debug=false
; TXDCOffset and RXDCOffset: -128 to 127
TXDCOffset=0
TXDelay=100
RXLevel=50
RXDCOffset=0
TXLevel=50
TXHang=5
; SX1255-specific
SPIDevice = /dev/spidev0.0
GPIOChip = gpiochip0
ResetPin = 22
; ALSA devices. Leave blank to use the SX1255's sound card automatically:
; capture is the first I2S device, and playback is taken from the same card,
; so HDMI audio is never picked. To choose a device, give one of:
;   hw:CARD,DEVICE        e.g. hw:1,0 (numbers from "arecord -l" / "aplay -l")
;   a device node path    e.g. /dev/snd/pcmC1D0c (capture) or pcmC1D1p (playback)
;   the exact device name, e.g. 3f203000.i2s-dir-hifi dir-hifi-0
; Card numbers can change between boots; device names don't.
ALSACaptureDevice = 
ALSAPlaybackDevice = 
; RX LNA gain. The SX1255 supports only these six settings, in uneven steps:
; 0, 12, 24, 36, 42 or 48 dB. Anything else is snapped to the nearest and logged.
;
; This is a compromise, not a "more is better" setting, because there is no AGC.
; Too little and weak signals are lost in the receiver's own noise; too much and
; strong ones overload the front end. Both show up as a rising bit error rate,
; which m17-gateway logs at the end of every received stream.
;
; 24 dB suits a typical hotspot: a handheld at 1 W a few metres away has been
; measured to overload at 36 dB and above, while a weaker or more distant signal
; needs more than 0 dB to be heard at all. Tune by watching the BER figures.
LNAGain = 24
; RX PGA gain (0-30 dB in 2 dB steps).
PGAGain = 0
; TX DAC gain (0, -3, -6, or -9 dB), where 0 is full scale.
; NOTE: releases before this one had this setting inverted, so a configured 0
; produced -9 dB and -9 produced 0 dB. If you tuned DACGain against an older
; build, negate it to keep the same transmit level.
DACGain = -3
; TX mixer gain (-37.5 to -7.5 dB in 2 dB steps)
MixerGain = -12
; Diagnostics: dump raw received IQ to a file for off-line analysis, then stop.
; ALSA hw devices are exclusive, so arecord cannot read the SX1255 while the
; gateway is running -- this is the way to capture what the gateway itself sees.
; The format is raw interleaved stereo S32_LE at 125000 Sa/s (left=I, right=Q).
; Leave blank to disable. Writes ~1 MB/s, so mind the card space.
RawIQCapture =
RawIQSeconds = 20